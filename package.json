{
  "name": "@tar-erpedia/deep-pack",
  "version": "0.3.0",
  "description": "pack a package and pack it's dependencies",
  "type": "module",
  "main": "./lib/deep-pack.js",
  "bin": {
    "npm-deep-pack": "./bin/deep-pack.js",
    "deep-pack": "./bin/deep-pack.js",
    "deep-pack-cli": "./bin/deep-pack.js"
  },
  "scripts": {
    "debug-test": "cd ./debug && rm -rf * && tsx ../src/deep-pack.ts \"next\"",
    "build": "tsc -p .",
    "local": "sudo npm i -g && npm-deep-pack",
    "zpublish": "npm publish --access public",
    "refresh": "rm -rf ./node_modules ./package-lock.json && npm install"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tar-erpedia/deep-pack.git"
  },
  "keywords": [
    "npm",
    "pack",
    "package",
    "tgz",
    "tar-tgz"
  ],
  "author": {
    "name": "DoradSoft"
  },
  "license": "GPL-3.0",
  "bugs": {
    "url": "https://github.com/tar-erpedia/deep-pack/issues"
  },
  "homepage": "https://github.com/tar-erpedia/deep-pack#readme",
  "dependencies": {
    "chalk": "^6.0.1",
    "commander": "^15.1.0",
    "figlet": "^1.12.0",
    "npm-package-arg": "^13.0.2",
    "pacote": "^21.5.3",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/npm-package-arg": "^6.1.4",
    "@types/pacote": "^11.1.8",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
